      "id": 20,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (command) (rate(purrrfolio_bot_command_total{job=~\"$job\"}[$__rate_interval])) * 60",
          "instant": false,
          "range": true,
          "refId": "A",
          "legendFormat": "{{command}}"
        }
      ]
