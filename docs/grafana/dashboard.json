{
  "title": "Purrrfolio",
  "uid": "purrrfolio",
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(purrrfolio_players, job)",
        "current": {
          "text": "purrrfolio_prod",
          "value": "purrrfolio_prod"
        },
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Players and acquisition",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Total players",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "max(purrrfolio_players{job=~\"$job\",period=\"total\"})",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ]
    },
